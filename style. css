body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0b0f19;
  color: white;
}

header {
  background: #111827;
  padding: 20px;
  text-align: center;
}

.hero {
  text-align: center;
  padding: 60px 20px;
}

.hero button {
  padding: 12px 24px;
  border: none;
  background: #2563eb;
  color: white;
  border-radius: 8px;
  font-size: 16px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  padding: 20px;
}

.card {
  background: #1f2937;
  padding: 20px;
  border-radius: 12px;
}

footer {
  text-align: center;
  padding: 20px;
  background: #111827;
}